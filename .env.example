# MongoDB - Get free from https://www.mongodb.com/atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/erp_nepal?retryWrites=true&w=majority

# JWT Secret (generate a random string)
JWT_SECRET=your_random_jwt_secret_here

# Server port (Render sets this automatically)
PORT=5000

# For production CORS (your frontend URL)
CLIENT_URL=https://your-app.vercel.app

# Node environment
NODE_ENV=development
